# ClipPipeline Studio render worker (docs/STUDIO_SPEC.md §3, §14). Never commit the real .env.
CLIPPIPELINE_API_URL=https://clippipeline.nonsostudio.com/api
# php artisan studio:worker-token (ability studio:worker). Keep the quotes: the token contains "|".
CLIPPIPELINE_WORKER_TOKEN=''
WORKER_ID=home-server-1
WORKER_CONCURRENCY=1
WORKER_CACHE_DIR=/var/cache/clippipeline-render
WORKER_POLL_SECONDS=5
# Remotion render threads (default: half the CPU cores).
REMOTION_CONCURRENCY=
# Optional: a Chrome Headless Shell to use instead of the one Remotion downloads.
REMOTION_BROWSER_EXECUTABLE=
# Transcription: faster-whisper model (tiny|base|small|medium), or ElevenLabs Scribe when a key is set
# (better for Nigerian accents and Pidgin).
STUDIO_WHISPER_MODEL=small
ELEVENLABS_API_KEY=
# Python with faster-whisper installed (e.g. /opt/clippipeline-render/venv/bin/python).
PYTHON=python3
# Only used when the server sets STUDIO_LINK_FETCHER=ytdlp.
YTDLP_BIN=yt-dlp
# Limit what this worker takes, e.g. "render_preview,render_final" on a second machine.
WORKER_CAPABILITIES=
